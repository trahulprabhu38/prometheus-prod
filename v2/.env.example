# Copy to .env  ->  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# --- Grafana admin login ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- GitHub SSO  ("Sign in with GitHub" on the Grafana login page) ---
# Non-secret settings (org restriction, scopes, sign-up) live in
# grafana/grafana.ini under [auth.github]; only the two OAuth-app credentials
# come from here. Create the OAuth app under the org:
#   https://github.com/organizations/2CentsCapital/settings/applications
#   Homepage URL:                https://grafana-infra.valura.co.in
#   Authorization callback URL:  https://grafana-infra.valura.co.in/login/github
GITHUB_OAUTH_CLIENT_ID=REPLACE_ME
GITHUB_OAUTH_CLIENT_SECRET=REPLACE_ME

# --- AWS (only needed for the "ecs" profile: YACE / CloudWatch) ---
# IAM user/role needs: cloudwatch:ListMetrics, cloudwatch:GetMetricData,
# cloudwatch:GetMetricStatistics, tag:GetResources, ecs:ListClusters,
# ecs:ListServices, ecs:DescribeServices   (read-only). See docs/05-ecs-metrics.md
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=ap-south-1

# --- Cloudflare (only for the imported "Cloudflare Analytics" dashboard) ---
# API token needs Analytics:Read on the zone. CF_ZONE_ID / CF_ACCOUNT_ID are
# referenced inside the dashboard's GraphQL queries.
CF_API_TOKEN=REPLACE_ME
CF_ACCOUNT_ID=REPLACE_ME
CF_ZONE_ID=REPLACE_ME
